# PostgreSQL + PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bloodnet_ai
POSTGRES_USER=bloodnet
POSTGRES_PASSWORD=bloodnet_dev_password
DATABASE_URL=postgresql://bloodnet:bloodnet_dev_password@localhost:5432/bloodnet_ai

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API (Express)
API_PORT=4000
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXTAUTH_SECRET=change_me_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
